<!-- Paste this entire block into one Custom HTML/embed block. -->
<div id="hcs-email-generator-embed">
  <style>
    #hcs-email-generator {
      --brand:#003366;
      --text:#0A0A0A;
      --muted:#333333;
      --bg:#FFFFFF;
      --card:#FFFFFF;
      --line:#C9D6E2;
      --focus:#FF9900;
      color: var(--text);
      background: var(--bg);
      font-size:16px;
    }

    #hcs-email-generator * {
      box-sizing: border-box;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, Helvetica, sans-serif;
    }

    #hcs-email-generator header {
      padding: 16px 20px;
      background: var(--card);
      border-bottom: 2px solid var(--line);
    }

    #hcs-email-generator header h1 {
      margin: 0;
      font-size: 20px;
    }

    #hcs-email-generator main {
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      padding: 20px;
      align-items:start;
    }

    #hcs-email-generator .card {
      background: var(--card);
      border: 2px solid var(--line);
      border-radius: 12px;
      padding: 16px;
    }

    #hcs-email-generator .card h2 {
      margin: 0 0 12px;
      font-size: 18px;
    }

    #hcs-email-generator fieldset {
      border:0;
      padding:0;
      margin:0 0 12px;
    }

    #hcs-email-generator legend {
      font-weight:700;
      margin-bottom:6px;
    }

    #hcs-email-generator .grid-2 {
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap:12px;
    }

    #hcs-email-generator label {
      display:block;
      font-size:14px;
      color:var(--muted);
      margin-bottom:6px;
    }

    #hcs-email-generator input,
    #hcs-email-generator select,
    #hcs-email-generator textarea,
    #hcs-email-generator button {
      font-size: 16px;
    }

    #hcs-email-generator input,
    #hcs-email-generator select,
    #hcs-email-generator textarea {
      width:100%;
      padding:10px 12px;
      border:2px solid var(--line);
      border-radius:10px;
      background:#fff;
      color:var(--text);
    }

    #hcs-email-generator input:focus,
    #hcs-email-generator select:focus,
    #hcs-email-generator textarea:focus,
    #hcs-email-generator button:focus {
      outline:3px solid var(--focus);
      outline-offset:2px;
    }

    #hcs-email-generator .help {
      font-size:14px;
      color:var(--muted);
    }

    #hcs-email-generator .row {
      margin-bottom:12px;
    }

    #hcs-email-generator .btns {
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      margin-top:8px;
    }

    #hcs-email-generator button {
      appearance:none;
      border:2px solid var(--brand);
      background:var(--brand);
      color:#fff;
      padding:.6rem 1rem;
      border-radius:9999px;
      cursor:pointer;
      font-weight:700;
    }

    #hcs-email-generator button.secondary {
      background:#fff;
      color:var(--brand);
    }

    #hcs-email-generator .preview {
      padding:18px;
      border:2px dashed var(--line);
      border-radius:12px;
      background:#fff;
      min-height: 220px;
    }

    #hcs-email-generator .signature {
      line-height:1.3;
      font-family: Arial, Helvetica, sans-serif;
      color:#111;
      font-size:14px;
    }

    #hcs-email-generator .signature a {
      color: var(--brand);
      text-decoration:none;
    }

    #hcs-email-generator .signature .name {
      font-weight:700;
      font-size:16px;
      color:#111;
    }

    #hcs-email-generator .signature .title,
    #hcs-email-generator .signature .dept {
      color:#222;
      font-size:14px;
    }

    #hcs-email-generator .signature .meta {
      color:#1a1a1a;
      font-size:14px;
    }

    #hcs-email-generator .locked-note {
      margin-top: 6px;
      font-size: 13px;
      color: var(--muted);
    }

    #hcs-email-generator #toast {
      position: fixed;
      top: 20px;
      right: 20px;
      background: var(--brand);
      color: #fff;
      padding: 10px 16px;
      border-radius: 8px;
      visibility: hidden;
      opacity: 0;
      pointer-events: none;
      z-index: 9999;
      box-shadow: 0 4px 14px rgba(0,0,0,.15);
    }

    #hcs-email-generator #toast.show {
      visibility: visible;
      opacity: 1;
    }

    @media (prefers-reduced-motion: reduce) {
      #hcs-email-generator * {
        animation:none !important;
        transition:none !important;
      }
    }

    @media (max-width: 980px) {
      #hcs-email-generator main {
        grid-template-columns:1fr;
      }
    }

    @media (max-width: 600px) {
      #hcs-email-generator .btns {
        flex-direction: column;
      }
    }

    @media (forced-colors: active) {
      #hcs-email-generator .preview,
      #hcs-email-generator .card,
      #hcs-email-generator input,
      #hcs-email-generator select,
      #hcs-email-generator textarea,
      #hcs-email-generator button {
        border: 1px solid CanvasText;
      }

      #hcs-email-generator button {
        forced-color-adjust:none;
        background: ButtonText;
        color: ButtonFace;
      }
    }
  </style>
  <div id="hcs-email-generator" aria-label="Harrison County Schools Email Signature Generator">
    <header>
      <h1>Harrison County Schools — Email Signature Generator</h1>
    </header>

    <div id="toast" aria-live="polite" aria-atomic="true"></div>

    <main>
      <section class="card" aria-labelledby="form-title">
        <h2 id="form-title">Build your signature</h2>
        <p id="form-help" class="help">
          Choose a school to auto-fill school name, office phone, fax (when available), address, and website.
          Standard keeps the logo. Compact removes the logo.
        </p>

        <form id="sig-form" novalidate>
          <fieldset>
            <legend>Approved templates</legend>

            <div class="row grid-2">
              <div>
                <label for="templateSelect">Template</label>
                <select id="templateSelect" name="templateSelect">
                  <option value="standard">Standard</option>
                  <option value="compact">Compact</option>
                </select>
              </div>
              <div>
                <label for="logoSelect">Choose school/department</label>
                <select id="logoSelect" name="logoSelect"></select>
              </div>
            </div>

            <div class="row grid-2">
              <div>
                <label for="logoWidth">Logo width (px)</label>
                <input id="logoWidth" name="logoWidth" type="number" value="120" min="60" max="220">
              </div>
              <div>
                <div class="help" style="margin-top:1.9rem">
                  Standard uses the school logo. Compact is text-only.
                </div>
              </div>
            </div>

            <div class="locked-note">
              Changing schools auto-fills school name, address, office phone, fax (when available), and website.
            </div>
          </fieldset>

          <fieldset>
            <legend>Identity</legend>

            <div class="row grid-2">
              <div>
                <label for="name">Full Name</label>
                <input id="name" name="name" type="text" autocomplete="name" required>
              </div>
              <div>
                <label for="title">Title</label>
                <input id="title" name="title" type="text">
              </div>
            </div>

            <div class="row grid-2">
              <div>
                <label for="dept">School / Location</label>
                <input id="dept" name="dept" type="text">
              </div>
              <div>
                <label for="email">Email</label>
                <input id="email" name="email" type="email" autocomplete="email" required>
              </div>
            </div>

            <div class="row grid-2">
              <div>
                <label for="phoneOffice">Office Phone</label>
                <input id="phoneOffice" name="phoneOffice" type="tel" inputmode="tel" placeholder="304-555-0123">
              </div>
              <div>
                <label for="phoneCell">Cell Phone</label>
                <input id="phoneCell" name="phoneCell" type="tel" inputmode="tel" placeholder="304-555-0456">
              </div>
            </div>

            <div class="row grid-2">
              <div>
                <label for="phoneFax">Fax</label>
                <input id="phoneFax" name="phoneFax" type="tel" inputmode="tel" placeholder="304-555-0789">
              </div>
              <div>
                <label for="web">Website</label>
                <input id="web" name="web" type="url" inputmode="url" placeholder="https://www.harcoboe.net">
              </div>
            </div>

            <div class="row grid-2">
              <div>
                <label for="address">Address</label>
                <input id="address" name="address" type="text" placeholder="445 W Main St, Clarksburg, WV 26301">
              </div>
              <div>
                <label for="room">Building / Room</label>
                <input id="room" name="room" type="text" placeholder="Admin, Room 100">
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>Social media (optional)</legend>

            <div class="row grid-2">
              <div>
                <label for="socialX">X</label>
                <input id="socialX" name="socialX" type="url" placeholder="https://x.com/HarrisonSchools">
              </div>
              <div>
                <label for="socialFB">Facebook</label>
                <input id="socialFB" name="socialFB" type="url" placeholder="https://facebook.com/HarrisonSchools">
              </div>
            </div>

            <div class="row grid-2">
              <div>
                <label for="socialIG">Instagram</label>
                <input id="socialIG" name="socialIG" type="url" placeholder="https://instagram.com/HarrisonSchools">
              </div>
              <div>
                <label for="socialYT">YouTube</label>
                <input id="socialYT" name="socialYT" type="url" placeholder="https://youtube.com/@HarrisonSchools">
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>Disclaimer (optional)</legend>
            <div class="row">
              <label for="disclaimer">Disclaimer text</label>
              <textarea id="disclaimer" name="disclaimer" rows="3"></textarea>
            </div>
          </fieldset>

          <div class="btns">
            <button type="button" id="copyOutlookBtn">Copy for Outlook</button>
            <button type="button" id="downloadHtmlBtn" class="secondary">Download .html</button>
            <button type="button" id="resetSchoolBtn" class="secondary">Reapply school auto-fill</button>
            <button type="button" id="clearBtn" class="secondary">Clear saved information</button>
          </div>
        </form>
      </section>

      <section class="card" aria-labelledby="preview-title">
        <h2 id="preview-title">Live preview</h2>
        <div id="preview" class="preview" role="region" aria-live="polite" aria-label="Signature preview"></div>
      </section>
    </main>
  </div>

  <script>
    (function(){
      const root = document.getElementById('hcs-email-generator');

      const SCHOOLS = [
        {
